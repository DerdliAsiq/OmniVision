# OMNIVISION C2 kimlik bilgileri
# UYARI: Varsayilan admin/1234 ile BIRAKMAYIN. Uretimde guclu bir sifre kullanin.
# Ornek: python -c "import secrets; print(secrets.token_urlsafe(16))"
C2_USERNAME=admin
C2_PASSWORD=buraya-guclu-bir-sifre-yazin
# C2'yi LAN'a acmak icin acik onay: 1 yapilmadikca varsayilan kimlik bilgileriyle
# sunucu yalnizca 127.0.0.1'de dinler.
C2_ALLOW_LAN=0
C2_PORT=8000
# LiDAR: auto veya COM4 / /dev/ttyUSB0 gibi zorla
LIDAR_PORT=auto
LIDAR_BAUD=115200
# Detector: her N karede bir inference (1=her kare)
PROCESS_INTERVAL=3
